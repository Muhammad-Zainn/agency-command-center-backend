<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Custom Project Proposal</title>
    <style>
        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            color: #333;
            line-height: 1.6;
            margin: 0;
            padding: 50px;
        }
        .header {
            border-bottom: 3px solid #2563eb;
            padding-bottom: 20px;
            margin-bottom: 30px;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }
        .agency-name { font-size: 32px; color: #2563eb; font-weight: bold; }
        .proposal-title { font-size: 20px; color: #64748b; text-align: right; }
        .section-title { font-size: 22px; color: #1e293b; border-bottom: 1px solid #e2e8f0; padding-bottom: 5px; margin-top: 40px; }
        .intro-message { font-size: 16px; margin-bottom: 30px; white-space: pre-wrap; }
        
        .milestones-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        .milestones-table th, .milestones-table td { border: 1px solid #cbd5e1; padding: 12px; text-align: left; }
        .milestones-table th { background-color: #f1f5f9; color: #334155; }
        .milestones-table td.cost { text-align: right; font-weight: bold; color: #059669; }
        
        .total-box { margin-top: 30px; background-color: #f8fafc; padding: 20px; border-radius: 8px; text-align: right; font-size: 22px; }
        .total-box span { font-weight: bold; color: #2563eb; }
        .terms { margin-top: 50px; font-size: 12px; color: #64748b; }
    </style>
</head>
<body>

    <div class="header">
        <div class="agency-name"><%= agencyName %></div>
        <div class="proposal-title">
            Proposal For: <strong><%= clientName %></strong><br>
            Date: <%= new Date().toLocaleDateString() %>
        </div>
    </div>

    <% if (customContent.introMessage) { %>
        <div class="intro-message">
            <p><%= customContent.introMessage %></p>
        </div>
    <% } %>

    <div class="section-title">1. Project Overview</div>
    <p>We are thrilled to present this proposal for <strong><%= projectTitle %></strong>.</p>
    
    <% if (customContent.scopeOfWork) { %>
        <p><%= customContent.scopeOfWork %></p>
    <% } %>

    <% if (customContent.milestones && customContent.milestones.length > 0) { %>
        <div class="section-title">2. Investment & Milestones</div>
        <table class="milestones-table">
            <thead>
                <tr>
                    <th>Milestone Description</th>
                    <th style="text-align: right;">Cost</th>
                </tr>
            </thead>
            <tbody>
                <% customContent.milestones.forEach(function(milestone) { %>
                    <tr>
                        <td><%= milestone.name %></td>
                        <td class="cost">$<%= milestone.cost.toLocaleString() %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    <% } %>

    <div class="total-box">
        Total Estimated Investment: <span>$<%= budget.toLocaleString() %></span>
    </div>

    <% if (customContent.includeTerms) { %>
        <div class="terms">
            <strong>Standard Terms:</strong> This proposal is valid for 30 days. Work begins upon signing of the official contract and receipt of the first milestone deposit.
        </div>
    <% } %>

</body>
</html>